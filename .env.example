# Configuração do Supabase para o SHOP7
# Obtenha estas chaves no painel do seu projeto Supabase: Project Settings > API

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Google Identity Services / OAuth 2.0 Client ID
# Obtenha no Google Cloud Console: APIs e Serviços > Credenciais > ID do cliente OAuth 2.0
VITE_GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
